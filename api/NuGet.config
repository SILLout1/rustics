<?xml version="1.0" encoding="utf-8"?>
<!--
  Собственные настройки NuGet для проекта.

  Нужны из-за машинного конфига Visual Studio
  (C:\Program Files (x86)\NuGet\Config\Microsoft.VisualStudio.FallbackLocation.config):
  он объявляет резервную папку пакетов "Microsoft Visual Studio\Shared\NuGetPackages",
  которой на машине может не быть. Тогда восстановление падает с NU1301 ещё до
  компиляции, а ключ выбора источника не помогает: резервная папка источником
  не считается и переопределяется только конфигом.

  Здесь обе вещи обнуляются и остаётся один nuget.org. Заодно сборка становится
  предсказуемой в Docker и на чужой машине, где набор источников другой.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <fallbackPackageFolders>
    <clear />
  </fallbackPackageFolders>
</configuration>
