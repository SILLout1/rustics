# Caddy вместо nginx ради одного: сертификат Let's Encrypt он получает и продлевает
# сам, без certbot и без задач в cron. Нужно лишь, чтобы домен уже указывал на этот
# сервер, а порты 80 и 443 были открыты — проверка идёт через них.
#
# {$SITE_DOMAIN} подставляется из .env: домен без протокола, например rustics.com.

# www уводим на основной адрес, а не обслуживаем оба.
# Это не косметика: вход через Steam и профиль игрока привязаны к origin.
# Зайдёт человек на www — у него будет отдельное хранилище и отдельный вход,
# и он решит, что сайт его разлогинил.
www.{$SITE_DOMAIN} {
	redir https://{$SITE_DOMAIN}{uri} permanent
}

{$SITE_DOMAIN} {
	encode gzip zstd

	# Функции живут на том же домене, что и сайт. Это требование Steam: он
	# возвращает игрока по адресу из openid.return_to и проверяет, что тот
	# лежит внутри realm. Разъедутся домены — вход перестанет работать.
	handle /api/* {
		reverse_proxy api:80
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server

		# Ассеты Vite носят хеш в имени: при новой сборке имя меняется, поэтому
		# старое можно кэшировать надолго и не бояться, что браузер застрянет
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"

		# А index.html кэшировать нельзя — он ссылается на текущие имена ассетов
		@html path / /index.html
		header @html Cache-Control "no-cache"
	}
}
