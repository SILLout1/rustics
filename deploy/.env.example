# Скопировать в .env рядом и заполнить. В git .env не кладём.

# Домен без протокола. Зона любая — .com, .ru, что купили.
# Caddy получит сертификат и на него, и на www.
SITE_DOMAIN=rustics.com

# Тот же домен целиком. Сюда Steam возвращает игрока после входа.
# Обязательно https, без www и без слэша на конце — www уводится сюда редиректом.
SITE_URL=https://rustics.com

# Ключ с steamcommunity.com/dev/apikey. Нужен и для входа, и для счётчика онлайна.
STEAM_API_KEY=

# Игровой сервер
SERVER_HOST=195.18.27.169
SERVER_PORT=35100
SERVER_QUERY_PORT=35110

# --- только для варианта с Cloudflare Tunnel ---
# Токен из панели Cloudflare (Zero Trust -> Networks -> Tunnels).
# При работе через туннель SITE_DOMAIN не используется, сертификат даёт Cloudflare.
TUNNEL_TOKEN=
